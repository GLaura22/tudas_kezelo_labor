@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/> .

<http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor> rdf:type owl:Ontology ;
                                                                    rdfs:comment "This is an onthology about NIS2 directive."@en .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/belongs_to
:belongs_to rdf:type owl:ObjectProperty ;
            rdfs:domain :Dokument ;
            rdfs:range :NIS2_requironment .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/completed
:completed rdf:type owl:ObjectProperty ;
           rdfs:domain :Company ;
           rdfs:range :NIS2_requironment ;
           rdfs:comment "Represents which NIS2 requironments the company have completed." .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/has
:has rdf:type owl:ObjectProperty ;
     rdfs:domain :Company ;
     rdfs:range :Compliance_status ;
     rdfs:comment """Company has a complience status 
(if it reaches the requironments)"""@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/requires
:requires rdf:type owl:ObjectProperty ;
          rdfs:domain :NIS2_requironment ;
          rdfs:range :Dokument ,
                     :Training ;
          rdfs:comment "NIS2 requironment requires a dokumentation"@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/works_in
:works_in rdf:type owl:ObjectProperty ;
          rdfs:domain :Company ;
          rdfs:range :Sector ;
          rdfs:comment "Company works in a sector"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/article
:article rdf:type owl:DatatypeProperty ;
         rdfs:domain :NIS2_requironment ;
         rdfs:range xsd:unsignedInt ;
         rdfs:comment "Shows in wich part of the directive speaks about the requironment." .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/comp_status
:comp_status rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:boolean .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/company_id
:company_id rdf:type owl:DatatypeProperty ;
            rdfs:domain :Company ;
            rdfs:range xsd:unsignedInt .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/has_employees
:has_employees rdf:type owl:DatatypeProperty ;
               rdfs:domain :Company ;
               rdfs:range xsd:unsignedInt .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/has_revenue
:has_revenue rdf:type owl:DatatypeProperty ;
             rdfs:domain :Company ;
             rdfs:range xsd:decimal .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/name
:name rdf:type owl:DatatypeProperty ;
      rdfs:domain :Company ;
      rdfs:range xsd:string ;
      rdfs:comment "Company name"@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/operatesInEU
:operatesInEU rdf:type owl:DatatypeProperty ;
              rdfs:domain :Company ;
              rdfs:range xsd:boolean .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/req_id
:req_id rdf:type owl:DatatypeProperty ;
        rdfs:domain :NIS2_requironment ;
        rdfs:range xsd:unsignedInt .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/s_id
:s_id rdf:type owl:DatatypeProperty ;
      rdfs:domain :Sector ;
      rdfs:range xsd:unsignedInt ;
      rdfs:comment "sector ID"@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/sector_id
:sector_id rdf:type owl:DatatypeProperty ;
           rdfs:domain :Company ;
           rdfs:range xsd:unsignedInt .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/Company
:Company rdf:type owl:Class ;
         rdfs:comment "Represents an organization being evaluated."@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/Compliance_status
:Compliance_status rdf:type owl:Class ;
                   rdfs:comment "Represents whether a company fulfills a requirement"@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/Dokument
:Dokument rdf:type owl:Class ;
          rdfs:comment "Represents dokuments required under NIS2."@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/NIS2_applicable_company
:NIS2_applicable_company rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Banking
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Digital_infrastructure
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Digital_providers
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Drinking_water
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Energy
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Financial_market_infrastructures
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Health
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :ICT_service_management
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Manufacture_production_and_distribution_of_chemicals
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Manufacturing
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Postal_and_courier_services
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Production_processing_and_distribution_of_food
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Public_administration
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Research
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Space
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Transport
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Waste_management
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :works_in ;
                                                               owl:hasValue :Waste_water
                                                             ]
                                                           )
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :has_employees ;
                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                    owl:onDatatype xsd:unsignedInt ;
                                                                    owl:withRestrictions ( [ xsd:minExclusive "50"^^xsd:unsignedInt
                                                                                           ]
                                                                                         )
                                                                  ]
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :has_revenue ;
                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                    owl:onDatatype xsd:decimal ;
                                                                    owl:withRestrictions ( [ xsd:minExclusive 10000000
                                                                                           ]
                                                                                         )
                                                                  ]
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :operatesInEU ;
                                               owl:hasValue "true"^^xsd:boolean
                                             ] ;
                         rdfs:subClassOf :Company .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/NIS2_requironment
:NIS2_requironment rdf:type owl:Class ;
                   rdfs:comment "Represents any obligation under NIS2."@en .


###  http://www.semanticweb.org/laura/ontologies/2025/10/nis2_auditor/Sector
:Sector rdf:type owl:Class ;
